# The Flow Labs — environment variables
# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard.
# Never commit real values.

# ---- Supabase ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key. Used by /api/content and /api/settings (read-only).
SUPABASE_ANON_KEY=

# Service role key. Used only by `/api/track` to insert page views.
# Server-side only. Never ship this to the browser.
SUPABASE_SERVICE_KEY=

# ---- Lab Report ----
# Strongly recommended. Google's keyless PSI quota is shared and runs out
# daily, which forces the scanner onto its markup-only estimate. A free
# key from console.cloud.google.com (PageSpeed Insights API) gives
# 25,000 requests/day at no cost.
PSI_KEY=

# Server-side key for /api/audit to write the scan cache to Supabase.
# Falls back to SUPABASE_ANON_KEY if unset.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Lead email notifications (api/notify.js) ----
# Inbox that receives new enquiries.
NOTIFY_TO=hello@theflowlabs.online

# SMTP credentials for the sending mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Blog rebuild (api/rebuild.js) ----
# Vercel -> project -> Settings -> Git -> Deploy Hooks -> create one on main.
# Flow HQ calls this after publishing, unpublishing or deleting a post.
VERCEL_DEPLOY_HOOK_URL=
