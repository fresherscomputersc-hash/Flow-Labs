{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/flow-hq/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/client/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".+\\.vercel\\.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/estimator",
      "destination": "/scoping/index.html"
    },
    {
      "source": "/estimator/:path*",
      "destination": "/scoping/index.html"
    },
    {
      "source": "/api/platform",
      "destination": "/api/platform/[...path].js"
    },
    {
      "source": "/api/platform/:path*",
      "destination": "/api/platform/[...path].js"
    },
    {
      "source": "/qr",
      "destination": "https://qr-sooty-phi.vercel.app/qr"
    },
    {
      "source": "/qr/:path*",
      "destination": "https://qr-sooty-phi.vercel.app/qr/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/qr/",
      "destination": "/qr",
      "permanent": false
    },
    {
      "source": "/cdn-cgi/l/email-protection",
      "destination": "/contact/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "the-flow-labs.vercel.app" }],
      "destination": "https://www.theflowlabs.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "flow-labs.vercel.app" }],
      "destination": "https://www.theflowlabs.online/$1",
      "permanent": true
    },
    {
      "source": "/flow-hq",
      "destination": "/flow-hq/",
      "permanent": false
    },
    {
      "source": "/client",
      "destination": "/client/",
      "permanent": false
    },
    {
      "source": "/services/ai-automation-bhubaneswar",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/services/ai-automation-bhubaneswar/:path*",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/services/web-development-bhubaneswar",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/services/web-development-bhubaneswar/:path*",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/services/custom-software-development-bhubaneswar",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/services/custom-software-development-bhubaneswar/:path*",
      "destination": "/bhubaneswar/",
      "permanent": true
    },
    {
      "source": "/blog/ai-automation-for-bhubaneswar-businesses",
      "destination": "/blog/ai-automation-for-small-businesses/",
      "permanent": true
    },
    {
      "source": "/blog/ai-automation-for-bhubaneswar-businesses/:path*",
      "destination": "/blog/ai-automation-for-small-businesses/:path*",
      "permanent": true
    }
  ]
}
